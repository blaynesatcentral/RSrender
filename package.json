{
  "name": "rsrender",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.1",
    "npm": "11.16.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "architecture:check": "node ./tooling/check-import-boundaries.mjs ./packages",
    "bootstrap:approved": "node ./tooling/run-approved-install-scripts.mjs",
    "build": "tsc -b --pretty false",
    "build:clean": "tsc -b --clean",
    "dependency:inventory": "node ./tooling/dependency-inventory.mjs",
    "dependency:enforce": "node ./tooling/enforce-dependency-admission-bld007.mjs --write",
    "dependency:test:drift": "node --test ./tests/bld-007-dependency-enforcement.test.mjs",
    "dependency:verify-admission": "node ./tooling/verify-dependency-admission.mjs",
    "format": "prettier --write package.json tsconfig.json tsconfig.base.json eslint.config.js packages tooling tests",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.base.json eslint.config.js packages tooling tests",
    "lint": "eslint .",
    "package": "node ./tooling/package-empty-workspace.mjs",
    "package:check": "node ./tooling/check-package-boundaries.mjs",
    "prebuild": "npm run dependency:enforce",
    "prepackage": "npm run dependency:enforce",
    "preshell:package": "npm run dependency:enforce",
    "shell:package": "node ./tooling/shell-package-bld006.mjs",
    "shell:test:packaged": "node ./tooling/shell-run-bld006.mjs --record",
    "shell:verify": "npm run build && npm run shell:package && npm run shell:test:packaged",
    "test": "node --test ./tests/*.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run dependency:enforce && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run package:check && npm run architecture:check && npm run dependency:verify-admission && npm run dependency:inventory && npm run package"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.8.49"
  },
  "devDependencies": {
    "@electron/packager": "20.0.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "electron": "43.4.0",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
